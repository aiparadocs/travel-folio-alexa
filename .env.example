# Defaults: local demo with no credentials and no external model/weather calls.
HOST=127.0.0.1
PORT=4317
AGENT_MODE=guided
WEATHER_MODE=demo

# For a phone on the same trusted Wi-Fi, use HOST=0.0.0.0.
# A LAN address will be chosen automatically; override it if needed:
# PUBLIC_BASE_URL=http://192.168.1.20:4317

# Optional, explicitly enabled cloud conversation (AWS charges may apply):
# AGENT_MODE=bedrock
# AWS_REGION=your-region
# BEDROCK_MODEL_ID=your-tool-capable-model-or-inference-profile-id
# Credentials come from the standard AWS SDK provider chain. Never put keys in browser files.

# Optional real forecast, independent of the conversation mode:
# WEATHER_MODE=live
# Node does not load this file by default. Set environment variables in your shell,
# or use: node --env-file=.env src/server.js (Node 20.6+).
